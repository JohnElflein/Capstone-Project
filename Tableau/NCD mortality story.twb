            <zone fixed-size='81' h='10125' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98484' x='758' y='5125' />
            <zone h='83750' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98484' x='758' y='15250'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
