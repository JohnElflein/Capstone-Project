            <zone h='93375' id='10' param='vert' type-v2='layout-flow' w='98400' x='800' y='5625'>
              <zone h='93375' id='8' type-v2='layout-basic' w='98400' x='800' y='5625'>
                <zone h='35938' id='3' name='NCD Mortality vs Urbanization' w='98400' x='800' y='52312'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
