                <zone h='46687' id='5' param='horz' type-v2='layout-flow' w='98400' x='800' y='5625'>
                  <zone h='46687' id='6' name='NCD Mortality vs GDP' w='49200' x='800' y='5625'>
                    <layout-cache minwidth='177' type-h='fixed' type-w='scalable' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='46687' id='7' name='NCD Mortality vs Health Expenditure' w='49200' x='50000' y='5625'>
                    <layout-cache minwidth='177' type-h='fixed' type-w='scalable' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
