    <dashboard enable-sort-zone-taborder='true' name='02 - An Uneven Global Pattern'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>A Uneven Global Pattern: NCD Mortality Change, 2000-2021</run>
