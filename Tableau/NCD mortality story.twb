      <size maxheight='1000' maxwidth='1069' minheight='800' minwidth='1000' sizing-mode='range' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98382' id='1' param='vert' removable='false' type-v2='layout-flow' w='98504' x='748' y='809'>
            <zone h='3337' id='3' type-v2='title' w='98504' x='748' y='809' />
            <zone fixed-size='81' h='8190' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98504' x='748' y='4146' />
            <zone h='86855' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98504' x='748' y='12336'>
              <flipboard active-id='7' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Cover - Introduction' captured-sheet='' id='1' />
                  <story-point caption='The Global Picture' captured-sheet='01 - The Global Picture' id='2'>
                    <capturedDeltas>
                      <worksheet name='Global NCD Mortality Trend with Global'>
                        <selection-collection />
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='An Uneven Global Pattern' captured-sheet='02 - An Uneven Global Pattern' id='4'>
                    <capturedDeltas>
                      <worksheet name='NCD Mortality Change by Country'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <format attr='title' class='0' field='[federated.02wloco1h7uu4v1c2q5my03tqcb8].[avg:Calculation_0113841983557637:qk]' scope='cols' value='NCD mortality change, 2000-2021 (%)' />
                          </style-rule>
                        </style>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Exploring Potential Factors' captured-sheet='03 - Exploring Potential Drivers' id='5' />
                  <story-point caption='Statistical Analysis' captured-sheet='04 - Statistical Analysis' id='6'>
                    <capturedDeltas>
                      <dashboard name='04 - Statistical Analysis'>
                        <zone id='13'>
                          <formatted-text>
                            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Overall conclusion</run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>The results provide partial support for the research hypothesis. Urbanization showed the strongest and most robust association with NCD mortality change: larger increases in urban population share were associated with larger increases-or smaller declines-in NCD mortality. </run>
                            <run>Æ&#10;&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>GDP growth was associated with larger declines in NCD mortality in the primary model, but this association was no longer statistically significant in the sensitivity analysis and is therefore not considered robust. Health expenditure showed no significant association in either model. Overall, the primary model explained 11.5% of the variation in cross-country NCD mortality changes, indicating that these three factors account for only a modest share of the differences between countries and that other factors likely contribute to the observed patterns. </run>
                            <run>Æ&#10;</run>
                            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10' italic='true'>These results indicate associations, not causal effects.</run>
                          </formatted-text>
                        </zone>
                      </dashboard>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Key Takeaways' captured-sheet='' id='7' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='11004' hidden='true' id='6' story-point-id='1' type-v2='text' w='97755' x='1123' y='17521'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'>Noncommunicable diseases (NCDs) are one of the world&apos;s largest health challenges.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='12286' hidden='true' id='8' story-point-id='1' type-v2='text' w='81384' x='9167' y='63248'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'>My research question:</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>How has NCD mortality changed across countries between 2000 and 2021, and how are economic development, healthcare expenditure, and urbanization associated with these changes?</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='10470' hidden='true' id='9' story-point-id='1' type-v2='text' w='48550' x='24883' y='79701'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Data:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> WHO · World Bank · UN</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Period:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> 2000-2021</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Analysis:</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> Cross-country descriptive and statistical analysis</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='4167' hidden='true' id='10' story-point-id='1' type-v2='text' w='34144' x='65669' y='95726'>
          <formatted-text>
            <run fontcolor='#333333' fontname='Benton Sans Book' fontsize='10'>Context statistics: World Health Organization (WHO), 2025</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='7500' hidden='true' id='11' story-point-id='1' type-v2='text' w='19000' x='6200' y='34500'>
          <formatted-text>
            <run bold='true' fontcolor='#499894' fontname='Benton Sans Book' fontsize='24'>43 MILLION</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>NCD deaths in 2021</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='7479' hidden='true' id='12' story-point-id='1' type-v2='text' w='28344' x='32647' y='34402'>
          <formatted-text>
            <run bold='true' fontcolor='#499894' fontname='Benton Sans Book' fontsize='24'>75%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>of non-pandemic-related deaths in 2021</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='7799' hidden='true' id='13' story-point-id='1' type-v2='text' w='31712' x='64920' y='34295'>
          <formatted-text>
            <run bold='true' fontcolor='#499894' fontname='Benton Sans Book' fontsize='24'>18 MILLION</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>NCD deaths among people under 70 in 2021</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='12286' hidden='true' id='14' story-point-id='1' type-v2='text' w='88120' x='6361' y='46261'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'>The four major NCD groups are:</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Cardiovascular diseases · Cancer · Chronic respiratory diseases · Diabetes</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Together, these four groups account for </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>80% </run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>of premature NCD deaths (before age 70).</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='9295' id='15' story-point-id='7' type-v2='text' w='91674' x='4210' y='16346'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='18'>NCD mortality declined overall between 2000 and 2021, but progress was highly uneven across countries.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='9295' id='16' story-point-id='7' type-v2='text' w='84846' x='8045' y='31838'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>NCD mortality declined overall</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>The average NCD mortality rate across countries fell by </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>17.5%</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>, from 643.7 to 531.2 deaths per 100,000 between 2000 and 2021.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='9936' id='17' story-point-id='7' type-v2='text' w='84939' x='8138' y='44765'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Progress was highly uneven</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Most countries experienced declines in NCD mortality, but the magnitude varied substantially. Some countries saw reductions of more than 40%, while others experienced increases between 2000 and 2021.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='12073' id='18' story-point-id='7' type-v2='text' w='85220' x='7764' y='58547'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Associations with socioeconomic factors were mixed</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Urbanization showed the strongest and most robust association</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Æ </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>with NCD mortality change.</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'> GDP per capita showed a negative association in the primary model, but this relationship was sensitive to influential observations. Health expenditure showed no statistically significant association.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='13034' id='19' story-point-id='7' type-v2='text' w='83162' x='9074' y='76496'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>Overall conclusion</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>The results provide </run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>partial support for the research hypothesis</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>. The three factors explained only a modest share (11.5%) of cross-country differences in NCD mortality change, suggesting that other economic, demographic, health-system, behavioral, and environmental factors also contribute to the observed patterns.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='6944' id='20' story-point-id='7' type-v2='text' w='33676' x='66324' y='93269'>
          <formatted-text>
